# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/careerlaunch?schema=public"

# Redis Configuration (BullMQ Queues)
REDIS_URL="redis://localhost:6379"

# AI / LLM Configuration (Groq Cloud)
# Server-side only; never expose to client or browser
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# Optional Feature Flags
FEATURE_AI_ENRICHMENT="true"
WORKER_CONCURRENCY="5"
