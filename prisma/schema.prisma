datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------
// Resume Management Models
// -------------------------------------------------
model Resume {
  id         String          @id @default(uuid())
  studentId  String
  title      String
  createdAt  DateTime        @default(now())
  versions   ResumeVersion[]
  user       User?           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

enum ResumeStatus {
  uploaded
  validating
  extracting
  parsing
  ready
  needs_review
  failed
}

model ResumeVersion {
  id               String        @id @default(uuid())
  resumeId         String
  versionNumber    Int
  originalFileName String
  mimeType         String
  fileSize         Int
  storageKey       String        @unique
  checksum         String
  status           ResumeStatus
  failureReason    String?
  extractedText    String?
  parsedData       Json?
  isActive         Boolean       @default(false)
  uploadedAt       DateTime      @default(now())
  parsedAt         DateTime?

  resume           Resume        @relation(fields: [resumeId], references: [id])
  parsedFieldReviews ParsedFieldReview[]
}

enum ReviewStatus {
  pending
  accepted
  edited
  rejected
}

model ParsedFieldReview {
  id               String        @id @default(uuid())
  resumeVersionId  String
  fieldPath        String
  originalValue    String
  correctedValue   String?
  status           ReviewStatus

  resumeVersion    ResumeVersion @relation(fields: [resumeVersionId], references: [id])
}

model ProfileSyncLog {
  id              String   @id @default(uuid())
  studentId       String
  resumeVersionId String
  fieldsApplied   Json
  appliedAt       DateTime @default(now())
}

// -------------------------------------------------
// Opportunity Data Models (Chunk 1)
// -------------------------------------------------

enum SourceCategory {
  jobs
  internships
  research
  scholarships
  hackathons
  training
  other
}

enum CollectionMethod {
  api
  rss
  scrape
  manual_import
}

enum ComplianceStatus {
  unreviewed
  permitted
  restricted
  blocked
}

enum SourceStatus {
  active
  paused
  failing
  disabled
}

enum ProcessingStatus {
  collected
  extracted
  failed
  skipped
}

enum VerificationStatus {
  verified
  pending
  unverified
  rejected
}

enum LifecycleStatus {
  active
  expiring
  expired
  removed
}

enum WorkMode {
  remote
  hybrid
  onsite
  unspecified
}

enum CompensationType {
  salary
  hourly
  stipend
  equity
  other
}

enum Currency {
  USD
  EUR
  GBP
  INR
  // add more as needed
}

model Source {
  id                 String            @id @default(uuid())
  name               String
  baseUrl            String
  category           SourceCategory
  collectionMethod   CollectionMethod
  config             Json
  complianceStatus   ComplianceStatus  @default(unreviewed)
  complianceNotes    String?
  termsUrl           String?
  robotsCheckedAt    DateTime?
  collectionFrequency Int               // in minutes
  reliabilityScore   Int               @default(0) // 0‑100
  status             SourceStatus      @default(disabled)
  lastSuccessAt      DateTime?
  lastFailureAt      DateTime?

  rawListings        RawListing[]
  collectionRuns     CollectionRun[]
  opportunitySources OpportunitySource[]
  opportunities      Opportunity[]
}

model RawListing {
  id                String   @id @default(uuid())
  sourceId          String
  sourceUrl         String   @unique
  externalId        String?
  rawHtml           String?
  rawJson           Json?
  rawText           String?
  contentHash       String
  fetchedAt         DateTime @default(now())
  httpStatus        Int
  processingStatus  ProcessingStatus @default(collected)

  source            Source   @relation(fields: [sourceId], references: [id])
}

model Opportunity {
  id                    String   @id @default(uuid())
  title                 String
  category              SourceCategory
  organizationName      String
  description           String?
  responsibilities      String?
  requiredSkills        String[]   // canonical skill IDs
  preferredSkills       String[]   // canonical skill IDs
  skillsExplicitOrInferred Json?    // {skillId: "explicit"|"inferred"}
  eligibility           Json      // complex object with flags per field
  locationCountry       String?
  locationState         String?
  locationCity          String?
  workMode              WorkMode @default(unspecified)
  compensation          Json?     // {type, min, max, currency, period}
  applicationDeadline   DateTime?
  postedAt              DateTime?
  sourceId              String
  sourceUrl             String
  originalText          String?
  applicationUrl        String?
  verificationStatus    VerificationStatus @default(pending)
  lifecycleStatus       LifecycleStatus @default(active)
  firstSeenAt           DateTime @default(now())
  lastCheckedAt         DateTime?
  lastChangedAt         DateTime?
  missingFields         String[]   // names of missing fields
  extractionConfidence  Float?
  canonicalOpportunityId String?
  isQuarantined         Boolean    @default(false)
  quarantineReasons     String[]   @default([])
  dataQualityScore      Float?

  careerRoleId          String?
  careerRole            CareerRole? @relation(fields: [careerRoleId], references: [id], onDelete: SetNull)

  source                Source @relation(fields: [sourceId], references: [id])
  opportunitySources    OpportunitySource[]
  opportunityChanges    OpportunityChange[]
  applications          Application[]

  @@index([category])
  @@index([locationCountry, locationState, locationCity])
  @@index([applicationDeadline])
  @@index([lifecycleStatus])
  @@index([isQuarantined])
  @@index([careerRoleId])
}

model OpportunitySource {
  opportunityId String
  sourceId      String
  sourceUrl     String
  seenAt        DateTime @default(now())

  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  source        Source      @relation(fields: [sourceId], references: [id])

  @@id([opportunityId, sourceId, sourceUrl])
}

model OpportunityChange {
  id           String   @id @default(uuid())
  opportunityId String
  field        String
  oldValue     String?
  newValue     String?
  detectedAt   DateTime @default(now())

  opportunity  Opportunity @relation(fields: [opportunityId], references: [id])
}

model CollectionRun {
  id            String   @id @default(uuid())
  sourceId      String
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  status        SourceStatus
  listingsFound Int      @default(0)
  newCount      Int      @default(0)
  updatedCount  Int      @default(0)
  failedCount   Int      @default(0)
  errorSummary  String?

  source        Source   @relation(fields: [sourceId], references: [id])
}

model Skill {
  id            String         @id @default(uuid())
  canonicalName String
  type          String         // technical|soft|domain|tool
  category      String?
  aliases       SkillAlias[]
  studentSkills StudentSkill[]
}

model SkillAlias {
  id      String @id @default(uuid())
  skillId String
  alias   String

  skill   Skill @relation(fields: [skillId], references: [id])
}

// -------------------------------------------------
// Notification & Preference Models (Chunk 7)
// -------------------------------------------------
model Notification {
  id            String   @id @default(uuid())
  userId        String
  type          String   // e.g., "new_opportunity", "deadline_reminder", "saved_search"
  title         String
  body          String?
  link          String?
  createdAt     DateTime @default(now())
  readAt        DateTime?

  // Optional references
  opportunityId String?
  applicationId String?
}

model NotificationPreference {
  id                 String   @id @default(uuid())
  userId             String
  channelInApp       Boolean  @default(true)
  channelEmail       Boolean  @default(false)
  frequency          String   @default("instant") // instant|daily|weekly
  quietHoursStart    Int?     // 0‑23
  quietHoursEnd      Int?     // 0‑23
  typeToggles        Json     @default("{}") // {"new_opportunity": true, ...}
}

model SavedSearch {
  id                 String   @id @default(uuid())
  userId             String
  name               String
  query              Json     // serialized filters
  frequency          String   @default("instant") // instant|daily|weekly
  createdAt          DateTime @default(now())
  lastTriggeredAt   DateTime?
}


enum ApplicationStatus {
  saved
  applied
  assessment
  interview
  selected
  rejected
  withdrawn
}

model Application {
  id                String   @id @default(uuid())
  userId            String
  opportunityId     String
  status            ApplicationStatus @default(saved)
  appliedDate       DateTime?
  notes             String?
  resumeVersionId   String?
  confirmationSource String @default("self_reported")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations (optional, schema may already have User and Opportunity models)
  opportunity       Opportunity @relation(fields: [opportunityId], references: [id])
}


model PotentialDuplicate {
  id           String   @id @default(uuid())
  opportunityA String   // Opportunity ID A
  opportunityB String   // Opportunity ID B
  similarity   Float
  status       String   @default("pending") // pending|merged|ignored
  createdAt    DateTime @default(now())
}


model User {
  id                  String              @id @default(uuid())
  email               String              @unique
  name                String?
  role                String              @default("student")
  passwordHash        String?
  status              String              @default("active")
  emailVerified       Boolean             @default(false)
  avatarUrl           String?
  onboardingCompleted Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  auditLogs           AuditLog[]
  studentProfile      StudentProfile?
  sessions            Session[]
  verificationTokens  VerificationToken[]
  resumes             Resume[]
  roadmaps            StudentRoadmap[]
  intelligenceJobs    ProfileIntelligenceJob[]
}

model Session {
  id        String   @id
  userId    String
  role      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  email     String
  type      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model RateLimit {
  key         String    @id
  attempts    Int       @default(0)
  lastAttempt DateTime  @default(now())
  lockedUntil DateTime?
}

// -------------------------------------------------
// Audit Log Model (Admin actions)
// -------------------------------------------------
model AuditLog {
  id          String   @id @default(uuid())
  adminId     String
  action      String
  target      String?   // e.g., "source", "user", "opportunity"
  targetId    String?   // optional id of the target entity
  details     Json?     // any additional info
  createdAt   DateTime @default(now())

  admin       User     @relation(fields: [adminId], references: [id])
}

// -------------------------------------------------
// Chunk 2: Data Model and Source Registry
// -------------------------------------------------

enum SourceRegistryCategory {
  job_board
  ats
  government
  internship_portal
}

enum SourceRegistryStatus {
  active
  permission_pending
  external_link_only
  disabled
}

enum IngestionOpportunityType {
  job
  internship
  fellowship
  research
}

model SourceRegistry {
  id              String                 @id // e.g. "naukri", "greenhouse", "lever", "ashby"
  name            String
  category        SourceRegistryCategory
  geography       String                 // e.g. "India", "Global", "US"
  accessMethod    String                 // e.g. "public_api", "licensed_api", "rss_feed", "external_search"
  status          SourceRegistryStatus   @default(disabled)
  termsUrl        String?
  refreshInterval Int                    // in minutes
  attributionText String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  ingestionRunLogs       IngestionRunLog[]
  connectorOpportunities ConnectorOpportunity[]
}

model ConnectorOpportunity {
  id                 String                   @id @default(uuid())
  title              String
  organization       String
  description        String
  type               IngestionOpportunityType
  experienceLevel    String                   // fresher, entry, mid, senior
  location           String?
  isRemote           Boolean                  @default(false)
  salary             String?
  skills             String[]
  postedDate         DateTime?
  deadline           DateTime?
  originalUrl        String
  sourceId           String
  sourceExternalId   String?
  fetchedAt          DateTime                 @default(now())
  lastVerifiedAt     DateTime?
  verificationStatus String                   @default("pending") // verified, pending, unverified, closed, rejected
  rawPayloadRef      String?                  // raw payload reference or storage key
  isQuarantined      Boolean                  @default(false)
  quarantineReasons  String[]                 @default([])
  dataQualityScore   Float?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  source             SourceRegistry           @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([type])
  @@index([isRemote])
  @@index([verificationStatus])
  @@index([isQuarantined])
}

model IngestionRunLog {
  id            String         @id @default(uuid())
  sourceId      String
  startTime     DateTime       @default(now())
  endTime       DateTime?
  status        String         @default("running") // running, completed, failed
  fetchedCount  Int            @default(0)
  newCount      Int            @default(0)
  updatedCount  Int            @default(0)
  rejectedCount Int            @default(0)
  errors        Json?          @default("[]")
  createdAt     DateTime       @default(now())

  source        SourceRegistry @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([status])
}

// -------------------------------------------------
// Phase 4: Student Profile Models (Chunk 4.1)
// -------------------------------------------------

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum SkillVerificationState {
  SELF_REPORTED
  CONFIRMED
  VERIFIED
}

enum ProfileFieldSource {
  STUDENT
  RESUME
  STUDENT_ENTERED
  RESUME_EXTRACTED
  ASSESSMENT_VERIFIED
  SYSTEM_DERIVED
}

model StudentProfile {
  id               String              @id @default(uuid())
  userId           String              @unique
  onboardingStatus OnboardingStatus    @default(NOT_STARTED)
  onboardingStep   Int?                @default(1)
  profileVersion   Int                 @default(1)
  lastCompletedAt  DateTime?
  lastUpdatedBy    String?             @default("STUDENT")
  college          String?
  degree           String?
  branch           String?
  currentYear      Int?
  graduationYear   Int?
  cgpa             Float?
  cgpaScale        Float?              @default(10.0)
  backlogs         Int?                @default(0)
  fieldMetadata    Json?               @default("{}")
  phone            String?
  bio              String?
  location         String?
  portfolioUrl     String?
  githubUrl        String?
  linkedinUrl      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills           StudentSkill[]
  interests        CareerInterest[]
  projects         StudentProject[]
  experiences      StudentExperience[]
  preference       StudentPreference?
}

// -------------------------------------------------
// Phase 4: Extended Profile Models (Chunk 4.2)
// -------------------------------------------------

enum SkillReviewStatus {
  CONFIRMED
  NEEDS_REVIEW
  REJECTED
}

model StudentSkill {
  id                String                 @id @default(uuid())
  studentProfileId  String
  skillId           String?
  rawSkillName      String?
  source            ProfileFieldSource     @default(STUDENT)
  reviewStatus      SkillReviewStatus      @default(CONFIRMED)
  verificationState SkillVerificationState @default(SELF_REPORTED)
  proficiency       String?
  yearsExperience   Float?
  experienceMonths  Int?
  confirmed         Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  studentProfile    StudentProfile         @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  skill             Skill?                 @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@unique([studentProfileId, skillId])
  @@index([studentProfileId])
  @@index([skillId])
}

model CareerInterest {
  id               String         @id @default(uuid())
  studentProfileId String
  targetRole       String
  domain           String
  priority         Int            @default(1)
  isPrimary        Boolean        @default(false)
  confirmedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, priority])
  @@index([studentProfileId])
}

model StudentRoadmap {
  id                  String    @id @default(uuid())
  userId              String
  careerRoleId        String
  careerRoleTitle     String
  domain              String
  profileVersion      Int       @default(1)
  generationVersion   Int       @default(1)
  isActive            Boolean   @default(true)
  currentModuleIndex  Int       @default(0)
  progressPercentage  Int       @default(0)
  milestonesCompleted Int       @default(0)
  totalMilestones     Int       @default(0)
  modules             Json      @default("[]")
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([careerRoleId])
  @@index([isActive])
}

model ProfileIntelligenceJob {
  id                  String    @id @default(uuid())
  userId              String
  profileId           String?
  jobType             String
  inputProfileVersion Int       @default(1)
  targetRoleId        String?
  status              String    @default("PENDING")
  model               String?
  promptVersion       String?
  resultRef           String?
  error               String?
  createdAt           DateTime  @default(now())
  completedAt         DateTime?

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([jobType])
}

model StudentProject {
  id               String             @id @default(uuid())
  studentProfileId String
  title            String
  description      String?
  technologies     String[]           @default([])
  repoUrl          String?
  liveUrl          String?
  source           ProfileFieldSource @default(STUDENT)
  confirmed        Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  studentProfile   StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
}

model StudentExperience {
  id               String             @id @default(uuid())
  studentProfileId String
  title            String
  company          String
  location         String?
  workMode         String?
  startDate        DateTime?
  endDate          DateTime?
  isCurrent        Boolean            @default(false)
  description      String?
  technologies     String[]           @default([])
  source           ProfileFieldSource @default(STUDENT)
  confirmed        Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  studentProfile   StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
}

model StudentPreference {
  id                 String         @id @default(uuid())
  studentProfileId   String         @unique
  preferredLocations String[]       @default([])
  preferredWorkModes String[]       @default([])
  preferredRoles     String[]       @default([])
  minExpectedSalary  Float?
  openToRelocation   Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  studentProfile     StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------
// Phase 5: Career Role Discovery Models (Chunk 5.1)
// -------------------------------------------------

model CareerRole {
  id               String        @id @default(uuid())
  canonicalName    String        @unique
  description      String?
  aliases          String[]      @default([])
  domain           String
  requiredSkillIds String[]      @default([])
  relatedSkillIds  String[]      @default([])
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  opportunities    Opportunity[]

  @@index([domain])
  @@index([isActive])
}



