  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node -e \"if(process.env.DATABASE_URL){try{require('child_process').execSync('npx prisma db push --accept-data-loss --skip-generate',{stdio:'inherit'})}catch(e){console.warn('Prisma db push warning:',e.message)}}\" && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "test": "node --experimental-strip-types --import ./scripts/resolve-aliases.js --test src/lib/services/**/__tests__/*.test.ts",
    "test:isolation": "node --experimental-strip-types --import ./scripts/resolve-aliases.js --test tests/isolation/crossAccountSecurity.test.ts",
    "ingest:real": "node --experimental-strip-types scripts/ingest_real_jobs.ts",
    "worker:verification": "node --experimental-strip-types src/workers/verificationWorker.ts",
    "scheduler:verification": "node --experimental-strip-types src/workers/verificationScheduler.ts",
    "scheduler:ingestion": "node --experimental-strip-types src/workers/jobIngestionScheduler.ts",
    "sweeper:freshness": "node --experimental-strip-types src/workers/freshnessSweeper.ts",
    "worker:enrichment": "node --experimental-strip-types src/workers/enrichmentWorker.ts"
  },
  "dependencies": {
